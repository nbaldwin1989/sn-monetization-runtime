"""
Structural Engineering & Build Verification: Simply Supported & Cantilever Beam Analysis
Calculates reaction forces, shear force distribution, bending moment distribution, 
deflection, and stresses under point and distributed loads.
"""

from dataclasses import dataclass
from typing import List, Tuple
import math


@dataclass
class PointLoad:
    magnitude: float  # Newtons (N)
    position: float   # meters (m) from left support


@dataclass
class DistributedLoad:
    magnitude: float  # N/m
    start: float      # meters (m)
    end: float        # meters (m)


class BeamAnalyzer:
    def __init__(
        self,
        length: float,
        elastic_modulus: float = 200e9,   # Steel: 200 GPa
        moment_of_inertia: float = 8.33e-6 # m^4
    ):
        """
        Initialize a simply supported beam with left support at x=0, right at x=length.
        """
        if length <= 0:
            raise ValueError("Beam length must be greater than zero.")
        self.length = length
        self.E = elastic_modulus
        self.I = moment_of_inertia
        self.point_loads: List[PointLoad] = []
        self.dist_loads: List[DistributedLoad] = []

    def add_point_load(self, magnitude: float, position: float) -> None:
        if not (0 <= position <= self.length):
            raise ValueError(f"Load position {position} outside beam length {self.length}.")
        self.point_loads.append(PointLoad(magnitude=magnitude, position=position))

    def add_distributed_load(self, magnitude: float, start: float, end: float) -> None:
        if not (0 <= start < end <= self.length):
            raise ValueError("Distributed load range must lie within [0, length].")
        self.dist_loads.append(DistributedLoad(magnitude=magnitude, start=start, end=end))

    def calculate_reactions(self) -> Tuple[float, float]:
        """
        Computes vertical reaction forces R_A (x=0) and R_B (x=L).
        Positive direction: upwards.
        """
        total_moment_about_a = 0.0
        total_vertical_load = 0.0

        for pl in self.point_loads:
            total_moment_about_a += pl.magnitude * pl.position
            total_vertical_load += pl.magnitude

        for udl in self.dist_loads:
            total_force = udl.magnitude * (udl.end - udl.start)
            centroid = (udl.start + udl.end) / 2.0
            total_moment_about_a += total_force * centroid
            total_vertical_load += total_force

        r_b = total_moment_about_a / self.length
        r_a = total_vertical_load - r_b
        return r_a, r_b

    def shear_force(self, x: float) -> float:
        """
        Calculates shear force V(x) at cross-section x.
        """
        if not (0 <= x <= self.length):
            raise ValueError("Cross-section x must be within beam bounds.")

        r_a, _ = self.calculate_reactions()
        v = r_a

        for pl in self.point_loads:
            if x >= pl.position:
                v -= pl.magnitude

        for udl in self.dist_loads:
            if x > udl.start:
                covered = min(x, udl.end) - udl.start
                v -= udl.magnitude * covered

        return v

    def bending_moment(self, x: float) -> float:
        """
        Calculates bending moment M(x) at cross-section x.
        """
        if not (0 <= x <= self.length):
            raise ValueError("Cross-section x must be within beam bounds.")

        r_a, _ = self.calculate_reactions()
        m = r_a * x

        for pl in self.point_loads:
            if x > pl.position:
                m -= pl.magnitude * (x - pl.position)

        for udl in self.dist_loads:
            if x > udl.start:
                load_span = min(x, udl.end) - udl.start
                centroid_dist = (x - udl.start) - (load_span / 2.0)
                m -= (udl.magnitude * load_span) * centroid_dist

        return m

    def max_bending_stress(self, max_moment: float, distance_from_neutral_axis: float) -> float:
        """
        Calculates maximum bending stress: sigma = (M * y) / I (in Pascals).
        """
        return (abs(max_moment) * distance_from_neutral_axis) / self.I

    def scan_extrema(self, steps: int = 1000) -> dict:
        """
        Discretizes the beam to find maximum shear force and bending moment.
        """
        dx = self.length / steps
        max_v = float("-inf")
        min_v = float("inf")
        max_m = float("-inf")
        min_m = float("inf")
        critical_x_m = 0.0

        for i in range(steps + 1):
            x = i * dx
            v = self.shear_force(x)
            m = self.bending_moment(x)

            if abs(v) > max_v:
                max_v = abs(v)
            if m > max_m:
                max_m = m
                critical_x_m = x
            if m < min_m:
                min_m = m

        r_a, r_b = self.calculate_reactions()
        return {
            "R_A": r_a,
            "R_B": r_b,
            "max_shear_force": max_v,
            "max_bending_moment": max_m,
            "critical_moment_x": critical_x_m,
        }


def main():
    # Proof of Work: 6-meter span I-beam analysis under standard construction loading
    beam = BeamAnalyzer(length=6.0, elastic_modulus=210e9, moment_of_inertia=1.17e-4)

    # 15 kN/m uniform dead load + 25 kN point load at center
    beam.add_distributed_load(magnitude=15000.0, start=0.0, end=6.0)
    beam.add_point_load(magnitude=25000.0, position=3.0)

    results = beam.scan_extrema()
    c = 0.15  # 300mm beam depth, c = 150mm
    sigma_max = beam.max_bending_stress(results["max_bending_moment"], c)

    print(f"Reaction Force Left  (R_A): {results['R_A']:.2f} N")
    print(f"Reaction Force Right (R_B): {results['R_B']:.2f} N")
    print(f"Max Shear Force       (V):   {results['max_shear_force']:.2f} N")
    print(f"Max Bending Moment    (M):   {results['max_bending_moment']:.2f} N*m at x = {results['critical_moment_x']:.2f} m")
    print(f"Max Bending Stress  (sigma): {sigma_max / 1e6:.2f} MPa")


if __name__ == "__main__":
    main()
