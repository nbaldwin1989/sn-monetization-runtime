"""
Construction & Engineering Proof-of-Work Toolkit
Module: structural_and_project_engine.py

Provides:
1. Structural Beam Analysis (Shear, Bending Moment, Deflection, AISC stress check)
2. Construction CPM (Critical Path Method) Schedule Engine
3. Earthwork Quantity Takeoff (Cut & Fill via Average End Area Method)
"""

from dataclasses import dataclass, field
from typing import Dict, List, Set, Tuple
import math


# ============================================================================
# 1. STRUCTURAL ANALYSIS ENGINE
# ============================================================================

@dataclass
class PointLoad:
    magnitude_kn: float  # Downward force in kN
    position_m: float    # Distance from left support in meters


@dataclass
class DistributedLoad:
    magnitude_kn_m: float  # Uniformly distributed load in kN/m
    start_m: float
    end_m: float


@dataclass
class BeamSection:
    depth_mm: float
    flange_width_mm: float
    web_thickness_mm: float
    flange_thickness_mm: float
    elastic_modulus_gpa: float = 200.0  # Structural Steel (GPa)
    yield_strength_mpa: float = 355.0   # S355 / Grade 50 (MPa)

    @property
    def moment_of_inertia_x_mm4(self) -> float:
        """Second moment of area (Ix) about strong axis for I-shaped section."""
        d = self.depth_mm
        bf = self.flange_width_mm
        tw = self.web_thickness_mm
        tf = self.flange_thickness_mm
        hw = d - 2 * tf
        # Ix = (bf * d^3 - (bf - tw) * hw^3) / 12
        return (bf * (d ** 3) - (bf - tw) * (hw ** 3)) / 12.0

    @property
    def elastic_section_modulus_mm3(self) -> float:
        return self.moment_of_inertia_x_mm4 / (self.depth_mm / 2.0)


class SimplySupportedBeam:
    """Analyzes simply supported beam under point and distributed loads."""

    def __init__(self, length_m: float, section: BeamSection):
        self.length = length_m
        self.section = section
        self.point_loads: List[PointLoad] = []
        self.distributed_loads: List[DistributedLoad] = []

    def add_point_load(self, magnitude_kn: float, position_m: float):
        if not (0.0 <= position_m <= self.length):
            raise ValueError(f"Position {position_m}m outside beam length {self.length}m")
        self.point_loads.append(PointLoad(magnitude_kn, position_m))

    def add_distributed_load(self, magnitude_kn_m: float, start_m: float, end_m: float):
        if not (0.0 <= start_m <= end_m <= self.length):
            raise ValueError("Load boundaries must fall within beam span.")
        self.distributed_loads.append(DistributedLoad(magnitude_kn_m, start_m, end_m))

    def compute_reactions(self) -> Tuple[float, float]:
        """Calculates vertical reaction forces R_left (R1) and R_right (R2) in kN."""
        moment_about_r1 = 0.0
        total_load = 0.0

        for pl in self.point_loads:
            total_load += pl.magnitude_kn
            moment_about_r1 += pl.magnitude_kn * pl.position_m

        for udl in self.distributed_loads:
            w = udl.magnitude_kn_m
            span = udl.end_m - udl.start_m
            load = w * span
            centroid = udl.start_m + span / 2.0
            total_load += load
            moment_about_r1 += load * centroid

        r2 = moment_about_r1 / self.length
        r1 = total_load - r2
        return r1, r2

    def internal_forces_at(self, x: float) -> Tuple[float, float]:
        """Calculates Shear Force (kN) and Bending Moment (kN*m) at point x (m)."""
        r1, _ = self.compute_reactions()
        shear = r1
        moment = r1 * x

        for pl in self.point_loads:
            if x >= pl.position_m:
                shear -= pl.magnitude_kn
                moment -= pl.magnitude_kn * (x - pl.position_m)

        for udl in self.distributed_loads:
            if x > udl.start_m:
                eff_end = min(x, udl.end_m)
                load_len = eff_end - udl.start_m
                load_val = udl.magnitude_kn_m * load_len
                shear -= load_val
                centroid = udl.start_m + (load_len / 2.0)
                moment -= load_val * (x - centroid)

        return shear, moment

    def evaluate_structural_integrity(self, step_m: float = 0.05) -> Dict[str, float]:
        """Scans beam span and evaluates maximum stresses and safety ratio."""
        n_steps = int(self.length / step_m) + 1
        max_shear_kn = 0.0
        max_moment_kn_m = 0.0

        for i in range(n_steps):
            x = min(i * step_m, self.length)
            v, m = self.internal_forces_at(x)
            max_shear_kn = max(max_shear_kn, abs(v))
            max_moment_kn_m = max(max_moment_kn_m, abs(m))

        # Max Bending Stress: sigma = M / W (MPa = (N*mm) / mm^3)
        m_max_n_mm = max_moment_kn_m * 1e6
        w_mm3 = self.section.elastic_section_modulus_mm3
        bending_stress_mpa = m_max_n_mm / w_mm3

        utilization_ratio = bending_stress_mpa / self.section.yield_strength_mpa
        passed = utilization_ratio <= 1.0

        return {
            "max_shear_kn": round(max_shear_kn, 2),
            "max_moment_kn_m": round(max_moment_kn_m, 2),
            "max_bending_stress_mpa": round(bending_stress_mpa, 2),
            "allowable_stress_mpa": self.section.yield_strength_mpa,
            "utilization_ratio": round(utilization_ratio, 3),
            "safety_factor": round(1.0 / utilization_ratio, 2) if utilization_ratio > 0 else float("inf"),
            "status": "PASS" if passed else "FAIL"
        }


# ============================================================================
# 2. CONSTRUCTION PROJECT SCHEDULER (CRITICAL PATH METHOD)
# ============================================================================

@dataclass
class Activity:
    id: str
    name: str
    duration_days: int
    predecessors: List[str] = field(default_factory=list)
    early_start: int = 0
    early_finish: int = 0
    late_start: int = 0
    late_finish: int = 0
    total_float: int = 0
    is_critical: bool = False


class CPMEngine:
    """Computes project duration, float, and critical paths for construction planning."""

    def __init__(self):
        self.activities: Dict[str, Activity] = {}

    def add_activity(self, activity_id: str, name: str, duration_days: int, predecessors: List[str] = None):
        if predecessors is None:
            predecessors = []
        self.activities[activity_id] = Activity(
            id=activity_id,
            name=name,
            duration_days=duration_days,
            predecessors=predecessors
        )

    def calculate_schedule(self) -> Dict[str, any]:
        # 1. Forward Pass (Early Start / Early Finish)
        successors_map: Dict[str, List[str]] = {aid: [] for aid in self.activities}
        for aid, act in self.activities.items():
            for p in act.predecessors:
                if p not in self.activities:
                    raise ValueError(f"Predecessor '{p}' not registered in schedule.")
                successors_map[p].append(aid)

        # Topological sorting
        in_degree = {aid: len(act.predecessors) for aid, act in self.activities.items()}
        queue = [aid for aid, deg in in_degree.items() if deg == 0]
        topo_order = []

        while queue:
            curr = queue.pop(0)
            topo_order.append(curr)
            for succ in successors_map[curr]:
                in_degree[succ] -= 1
                if in_degree[succ] == 0:
                    queue.append(succ)

        if len(topo_order) != len(self.activities):
            raise ValueError("Dependency loop detected in construction activity network.")

        for aid in topo_order:
            act = self.activities[aid]
            if not act.predecessors:
                act.early_start = 0
            else:
                act.early_start = max(self.activities[p].early_finish for p in act.predecessors)
            act.early_finish = act.early_start + act.duration_days

        project_duration = max(act.early_finish for act in self.activities.values())

        # 2. Backward Pass (Late Start / Late Finish)
        for aid in reversed(topo_order):
            act = self.activities[aid]
            succs = successors_map[aid]
            if not succs:
                act.late_finish = project_duration
            else:
                act.late_finish = min(self.activities[s].late_start for s in succs)
            act.late_start = act.late_finish - act.duration_days
            act.total_float = act.late_start - act.early_start
            act.is_critical = (act.total_float == 0)

        critical_path = [aid for aid in topo_order if self.activities[aid].is_critical]

        return {
            "total_duration_days": project_duration,
            "critical_path": critical_path,
            "schedule": {
                aid: {
                    "name": act.name,
                    "duration": act.duration_days,
                    "ES": act.early_start,
                    "EF": act.early_finish,
                    "LS": act.late_start,
                    "LF": act.late_finish,
                    "float": act.total_float,
                    "critical": act.is_critical
                }
                for aid, act in self.activities.items()
            }
        }


# ============================================================================
# 3. EARTHWORK QUANTITY TAKEOFF ENGINE
# ============================================================================

@dataclass
class CrossSectionStation:
    station_chainage_m: float
    cut_area_m2: float
    fill_area_m2: float


class EarthworkTakeoff:
    """Calculates cumulative Cut and Fill earthwork volumes along station alignments."""

    def __init__(self):
        self.stations: List[CrossSectionStation] = []

    def add_station(self, chainage_m: float, cut_area_m2: float, fill_area_m2: float):
        self.stations.append(CrossSectionStation(chainage_m, cut_area_m2, fill_area_m2))
        self.stations.sort(key=lambda s: s.station_chainage_m)

    def compute_volumes(self) -> Dict[str, float]:
        """Calculates volume using the standard Average End Area method."""
        if len(self.stations) < 2:
            return {"cut_volume_m3": 0.0, "fill_volume_m3": 0.0, "net_volume_m3": 0.0}

        total_cut_m3 = 0.0
        total_fill_m3 = 0.0

        for i in range(len(self.stations) - 1):
            s1 = self.stations[i]
            s2 = self.stations[i + 1]
            dist = s2.station_chainage_m - s1.station_chainage_m

            cut_vol = ((s1.cut_area_m2 + s2.cut_area_m2) / 2.0) * dist
            fill_vol = ((s1.fill_area_m2 + s2.fill_area_m2) / 2.0) * dist

            total_cut_m3 += cut_vol
            total_fill_m3 += fill_vol

        return {
            "cut_volume_m3": round(total_cut_m3, 2),
            "fill_volume_m3": round(total_fill_m3, 2),
            "net_volume_m3": round(total_cut_m3 - total_fill_m3, 2)  # Positive = surplus/export, Negative = borrow
        }


# ============================================================================
# VERIFICATION & PROOF-OF-WORK DEMONSTRATION
# ============================================================================

if __name__ == "__main__":
    print("=== Construction & Engineering POW Demo ===")

    # 1. Structural Verification: I-Beam HEA 300 under combined loads
    beam_section = BeamSection(
        depth_mm=290.0,
        flange_width_mm=300.0,
        web_thickness_mm=8.5,
        flange_thickness_mm=14.0,
        yield_strength_mpa=355.0
    )
    beam = SimplySupportedBeam(length_m=8.0, section=beam_section)
    beam.add_distributed_load(magnitude_kn_m=12.0, start_m=0.0, end_m=8.0)
    beam.add_point_load(magnitude_kn=45.0, position_m=4.0)
    r1, r2 = beam.compute_reactions()
    structural_results = beam.evaluate_structural_integrity()
    print(f"[Structural Beam] Reactions: R1={r1:.2f} kN, R2={r2:.2f} kN")
    print(f"[Structural Beam] Integrity: {structural_results}")

    # 2. Construction Schedule: Building Foundation & Superstructure
    cpm = CPMEngine()
    cpm.add_activity("A", "Site Clearing & Demolition", 4)
    cpm.add_activity("B", "Excavation & Trenching", 6, ["A"])
    cpm.add_activity("C", "Underground Utilities", 5, ["B"])
    cpm.add_activity("D", "Rebar & Formwork", 7, ["B"])
    cpm.add_activity("E", "Foundation Pour & Cure", 8, ["C", "D"])
    cpm.add_activity("F", "Structural Steel Erection", 10, ["E"])
    schedule_results = cpm.calculate_schedule()
    print(f"[CPM Scheduler] Total Duration: {schedule_results['total_duration_days']} days")
    print(f"[CPM Scheduler] Critical Path: {' -> '.join(schedule_results['critical_path'])}")

    # 3. Earthwork Analysis
    earthwork = EarthworkTakeoff()
    earthwork.add_station(chainage_m=0.0, cut_area_m2=15.0, fill_area_m2=2.0)
    earthwork.add_station(chainage_m=50.0, cut_area_m2=25.0, fill_area_m2=1.0)
    earthwork.add_station(chainage_m=100.0, cut_area_m2=8.0, fill_area_m2=12.0)
    volumes = earthwork.compute_volumes()
    print(f"[Earthwork Takeoff] Cut/Fill Volumes: {volumes}")
