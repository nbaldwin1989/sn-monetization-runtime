import csv
import io
import json
from dataclasses import asdict, dataclass
from typing import Dict, List, Optional


@dataclass
class SNBounty:
    item_id: int
    territory: str
    tier: int
    comments_count: int
    bounty_amount: int
    min_rank: int
    weight_score: float
    author_id: int
    created_at_epoch: int
    feed_channel: str
    status_tags: List[str]
    title: str

    @classmethod
    def from_tsv(cls, line: str) -> "SNBounty":
        reader = csv.reader(io.StringIO(line.strip()), delimiter="\t")
        fields = next(reader)
        if len(fields) < 12:
            raise ValueError(f"Expected 12 tab-delimited fields, got {len(fields)}")

        return cls(
            item_id=int(fields[0]),
            territory=fields[1],
            tier=int(fields[2]),
            comments_count=int(fields[3]),
            bounty_amount=int(fields[4]),
            min_rank=int(fields[5]),
            weight_score=float(fields[6]),
            author_id=int(fields[7]),
            created_at_epoch=int(fields[8]),
            feed_channel=fields[9],
            status_tags=[tag.strip() for tag in fields[10].split(",") if tag.strip()],
            title=fields[11],
        )

    @property
    def is_open(self) -> bool:
        return "OPEN_BOUNTY" in self.status_tags

    @property
    def is_low_competition(self) -> bool:
        return "LOW_COMP" in self.status_tags


class StructuralEngineeringPowSuite:
    """
    Proof-of-Work suite for Construction & Engineering builds:
    Performs structural beam deflection analysis and concrete mix validation.
    """

    @staticmethod
    def simply_supported_beam_deflection(
        load_kn: float, length_m: float, e_gpa: float, i_cm4: float
    ) -> Dict[str, float]:
        """
        Calculates maximum deflection (center) and bending moment for a simply supported
        beam under a point load at mid-span.
        """
        # Convert to SI units (N, m, Pa, m^4)
        load_n = load_kn * 1000.0
        e_pa = e_gpa * 1e9
        i_m4 = i_cm4 * 1e-8

        # Max deflection: delta = (P * L^3) / (48 * E * I)
        max_deflection_m = (load_n * (length_m**3)) / (48.0 * e_pa * i_m4)

        # Max bending moment: M = (P * L) / 4
        max_moment_nm = (load_n * length_m) / 4.0

        return {
            "load_kN": load_kn,
            "span_m": length_m,
            "max_deflection_mm": round(max_deflection_m * 1000.0, 4),
            "max_moment_kNm": round(max_moment_nm / 1000.0, 4),
        }

    @staticmethod
    def concrete_mix_ratio_validation(
        cement_kg: float, sand_kg: float, gravel_kg: float, target_ratio: str = "1:2:4"
    ) -> Dict[str, any]:
        """Validates volumetric or mass ratio for structural concrete batches."""
        if cement_kg <= 0:
            raise ValueError("Cement weight must be greater than zero.")
        r_sand = sand_kg / cement_kg
        r_gravel = gravel_kg / cement_kg
        actual_ratio = f"1:{r_sand:.2f}:{r_gravel:.2f}"

        return {
            "target_ratio": target_ratio,
            "actual_ratio": actual_ratio,
            "is_within_tolerance": abs(r_sand - 2.0) <= 0.2
            and abs(r_gravel - 4.0) <= 0.4,
        }


class BountyDispatchHandler:
    def __init__(self):
        self.pow_engine = StructuralEngineeringPowSuite()

    def handle_bounty(self, raw_record: str) -> Dict[str, any]:
        bounty = SNBounty.from_tsv(raw_record)
        if not bounty.is_open:
            return {"status": "SKIPPED", "reason": "Bounty is not open."}

        # Build proof-of-work solution for the Construction & Engineering channel
        pow_deflection = self.pow_engine.simply_supported_beam_deflection(
            load_kn=50.0, length_m=6.0, e_gpa=200.0, i_cm4=8356.0
        )
        pow_mix = self.pow_engine.concrete_mix_ratio_validation(
            cement_kg=350.0, sand_kg=700.0, gravel_kg=1400.0
        )

        response_payload = {
            "bounty_id": bounty.item_id,
            "channel": bounty.feed_channel,
            "bounty_sats": bounty.bounty_amount,
            "title": bounty.title,
            "submission_ready": True,
            "proof_of_work": {
                "project_title": "Automated Structural Load & Mix Validation Tool",
                "beam_analysis": pow_deflection,
                "concrete_validation": pow_mix,
            },
        }
        return response_payload


def process_event(event_line: str) -> str:
    handler = BountyDispatchHandler()
    result = handler.handle_bounty(event_line)
    return json.dumps(result, indent=2)


if __name__ == "__main__":
    sample_input = "1593928\tConstruction_and_Engineering\t2\t42\t5000\t0\t19.4\t9274\t28475\ttop@Construction_and_Engineering\tOPEN_BOUNTY,LOW_COMP\tShow Your Build Weekly #5: Post Your Proof-of-Work 🔨"
    print(process_event(sample_input))
