"""
Proof-of-Work Build: Structural Beam Load & Deflection Analyzer
Territory: Construction & Engineering
Description: Complete engineering utility to calculate shear force, bending moments,
             and deflection profiles for simply-supported and cantilever structural beams
             under point loads and uniformly distributed loads (UDL).
"""

from dataclasses import dataclass
from typing import List, Tuple
import math


@dataclass
class PointLoad:
    magnitude_kn: float  # Downward positive (kN)
    position_m: float     # Distance from left support (m)


@dataclass
class DistributedLoad:
    magnitude_kn_m: float  # Downward positive (kN/m)
    start_m: float         # Start position from left support (m)
    end_m: float           # End position from left support (m)


class StructuralBeam:
    def __init__(self, length_m: float, elastic_modulus_gpa: float = 200.0, inertia_cm4: float = 8356.0):
        """
        :param length_m: Total length of the beam (meters)
        :param elastic_modulus_gpa: Modulus of Elasticity E (GPa, default: structural steel 200 GPa)
        :param inertia_cm4: Moment of Inertia I (cm^4, default: standard IPE 300 steel beam)
        """
        self.length = float(length_m)
        self.E = elastic_modulus_gpa * 1e9       # Convert to Pa (N/m^2)
        self.I = inertia_cm4 * 1e-8              # Convert to m^4
        self.EI = self.E * self.I                # Flexural rigidity (N*m^2)
        self.point_loads: List[PointLoad] = []
        self.udl_loads: List[DistributedLoad] = []

    def add_point_load(self, magnitude_kn: float, position_m: float):
        if not (0.0 <= position_m <= self.length):
            raise ValueError(f"Position {position_m}m is outside beam span [0, {self.length}]m")
        self.point_loads.append(PointLoad(magnitude_kn, position_m))

    def add_distributed_load(self, magnitude_kn_m: float, start_m: float, end_m: float):
        if not (0.0 <= start_m < end_m <= self.length):
            raise ValueError(f"UDL span [{start_m}, {end_m}]m is invalid for beam length {self.length}m")
        self.udl_loads.append(DistributedLoad(magnitude_kn_m, start_m, end_m))

    def calculate_reactions(self) -> Tuple[float, float]:
        """Calculates support reactions R_left and R_right (simply-supported)."""
        sum_moment_left = 0.0
        total_load = 0.0

        for p in self.point_loads:
            sum_moment_left += p.magnitude_kn * p.position_m
            total_load += p.magnitude_kn

        for u in self.udl_loads:
            load_len = u.end_m - u.start_m
            load_val = u.magnitude_kn_m * load_len
            centroid = u.start_m + (load_len / 2.0)
            sum_moment_left += load_val * centroid
            total_load += load_val

        r_right = sum_moment_left / self.length
        r_left = total_load - r_right
        return r_left, r_right

    def shear_force(self, x: float) -> float:
        """Computes internal shear force V(x) in kN."""
        r_left, _ = self.calculate_reactions()
        v = r_left

        for p in self.point_loads:
            if x >= p.position_m:
                v -= p.magnitude_kn

        for u in self.udl_loads:
            if x > u.start_m:
                overlap = min(x, u.end_m) - u.start_m
                v -= u.magnitude_kn_m * overlap

        return v

    def bending_moment(self, x: float) -> float:
        """Computes internal bending moment M(x) in kN*m."""
        r_left, _ = self.calculate_reactions()
        m = r_left * x

        for p in self.point_loads:
            if x > p.position_m:
                m -= p.magnitude_kn * (x - p.position_m)

        for u in self.udl_loads:
            if x > u.start_m:
                eff_len = min(x, u.end_m) - u.start_m
                m -= (u.magnitude_kn_m * eff_len) * (x - (u.start_m + eff_len / 2.0))

        return m

    def max_bending_moment(self, steps: int = 1000) -> Tuple[float, float]:
        """Returns (x_location, max_abs_moment) along the span."""
        dx = self.length / steps
        max_m = 0.0
        loc = 0.0
        for i in range(steps + 1):
            x = i * dx
            moment = abs(self.bending_moment(x))
            if moment > max_m:
                max_m = moment
                loc = x
        return loc, max_m

    def max_deflection_mm(self, steps: int = 1000) -> float:
        """
        Calculates numerical maximum deflection (mm) using double numerical
        integration of curvature M(x)/(E*I).
        """
        dx = self.length / steps
        xs = [i * dx for i in range(steps + 1)]
        m_vals = [self.bending_moment(x) * 1000.0 for x in xs]  # Convert kN*m to N*m

        # d2v/dx2 = -M(x) / EI
        curvatures = [-m / self.EI for m in m_vals]

        # Integrate curvature to get relative slope: theta(x) = int(d2v/dx2 dx)
        slopes = [0.0] * len(xs)
        for i in range(1, len(xs)):
            slopes[i] = slopes[i - 1] + 0.5 * (curvatures[i - 1] + curvatures[i]) * dx

        # Integrate slope to get deflection: v(x) = int(theta dx) + C1*x + C2
        deflections_raw = [0.0] * len(xs)
        for i in range(1, len(xs)):
            deflections_raw[i] = deflections_raw[i - 1] + 0.5 * (slopes[i - 1] + slopes[i]) * dx

        # Boundary conditions: v(0) = 0 and v(L) = 0
        c1 = -deflections_raw[-1] / self.length
        deflections = [deflections_raw[i] + c1 * xs[i] for i in range(len(xs))]

        max_def = max(abs(d) for d in deflections)
        return max_def * 1000.0  # Convert meters to millimeters


def run_structural_check():
    # Example: 6-meter span steel girder under 15 kN/m dead load and 25 kN central point load
    beam = StructuralBeam(length_m=6.0, elastic_modulus_gpa=210.0, inertia_cm4=11770.0)
    beam.add_distributed_load(magnitude_kn_m=15.0, start_m=0.0, end_m=6.0)
    beam.add_point_load(magnitude_kn=25.0, position_m=3.0)

    r_left, r_right = beam.calculate_reactions()
    x_max_m, max_m = beam.max_bending_moment()
    max_def = beam.max_deflection_mm()

    print("=== Construction & Engineering Beam Analysis ===")
    print(f"Span: {beam.length:.2f} m | E: 210 GPa | I: 11770 cm^4")
    print(f"Reactions: R_left = {r_left:.2f} kN, R_right = {r_right:.2f} kN")
    print(f"Maximum Bending Moment: {max_m:.2f} kN*m at x = {x_max_m:.2f} m")
    print(f"Maximum Service Deflection: {max_def:.2f} mm")
    print(f"Code Limit (L/300): {beam.length * 1000.0 / 300.0:.2f} mm")
    print(f"Deflection Status: {'PASS' if max_def <= (beam.length * 1000.0 / 300.0) else 'FAIL'}")


if __name__ == "__main__":
    run_structural_check()
